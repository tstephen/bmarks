<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
    <head>
        <title>Bookmarks</title>
        <url>https://bookshelf.knowprocess.com/bookmarks.opml</url>
        <dateCreated>{{ now }}</dateCreated>
        <dateModified>{{ now }}</dateModified>
        <ownerId>https://bookshelf.knowprocess.com/</ownerId>
    </head>
    <body>
        {% for outline in outlines %}
        <outline
            text="{{ outline.title|e }}"
            type="{{ outline.type|default('link')|e }}"
            {% if outline.xmlUrl %}xmlUrl="{{ outline.xmlUrl|e }}"{% endif %}
            {% if outline.url %}htmlUrl="{{ outline.url|e }}"{% endif %}
            {% if outline.category %}category="{{ outline.category|replace('|', '/')|e }}"{% endif %}
            {% if outline.description %}description="{{ outline.description|e }}"{% endif %}
        />
        {% endfor %}
    </body>
</opml>